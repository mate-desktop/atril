#: data/atril.appdata.xml.in.in:7 data/atril.desktop.in.in:2
#: shell/ev-window.c:5516
msgid "Atril Document Viewer"
msgstr "Visor de Documentos Atril"

#: data/atril.appdata.xml.in.in:8
msgid "A Document Viewer for the MATE desktop environment"
msgstr "Un Visor de Documentos para el entorno de escritorio MATE"

#: data/atril.appdata.xml.in.in:10
msgid ""
"Atril is a simple multi-page document viewer. It can display and print "
"PostScript (PS), Encapsulated PostScript (EPS), DJVU, DVI, XPS and Portable "
"Document Format (PDF) files, as well as comic book archive files. When "
"supported by the document, it also allows searching for text, copying text "
"to the clipboard, hypertext navigation and table-of-contents bookmarks."
msgstr ""
"Atril es un visor sencillo de documentos de varias páginas. Puede mostrar e "
"imprimir archivos PostScript (PS), Encapsulated PostScript (EPS), DJVU, DVI, "
"XPS y Portable Document Format (PDF), así como archivos de cómics. Cuando el "
"documento lo permite, también ofrece funciones de búsqueda de texto, copia "
"de texto al portapapeles, navegación por hipervínculos y marcadores de tabla "
"de contenido."

#: data/atril.appdata.xml.in.in:18
msgid ""
"Atril is a fork of Evince and part of the MATE Desktop Environment. If you "
"would like to know more about MATE and Atril, please visit the project's "
"home page."
msgstr ""
"Atril es una bifurcación de Evince y forma parte del entorno de escritorio "
"MATE. Si desea saber más sobre MATE y Atril, visite la página web del "
"proyecto."

#: data/atril.desktop.in.in:3 shell/ev-window-title.c:157
msgid "Document Viewer"
msgstr "Visor de Documentos"

#: data/atril.desktop.in.in:4
msgid "View multi-page documents"
msgstr "Ver documentos de varias páginas"

